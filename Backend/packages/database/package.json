{
  "name": "@error-tracker/database",
  "version": "1.0.0",
  "description": "Drizzle ORM schema, migrations and client for Error Tracker",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "generate": "drizzle-kit generate",
    "lint": "echo 'Database linted'"
  },
  "dependencies": {
    "@error-tracker/contracts": "workspace:*",
    "drizzle-orm": "^0.39.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
